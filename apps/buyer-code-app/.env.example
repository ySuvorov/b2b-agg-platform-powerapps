# Copy to .env.local and fill in values. Never commit .env.local.

# Copilot Studio — MarketBot embed URL
# Get from: Copilot Studio → Settings → Channels → Custom website → iframe src
VITE_COPILOT_BOT_URL=

# Power BI workspace URL (used by Insights.tsx as a help link when reports aren't embedded yet)
# Get from: Power BI Service → workspace → copy the browser URL
VITE_PBI_WORKSPACE_URL=

# Power BI report embed URLs (JSON map, keys match Insights.tsx REPORT_SLOTS)
# Get from: Power BI Service → report → File → Embed report → Website or portal
# Example:
# VITE_PBI_REPORTS={"regional_demand":"https://app.powerbi.com/reportEmbed?...","supplier_scorecard":"...","top_moving_skus":"...","price_spread":"..."}
VITE_PBI_REPORTS=

# --- AS-BUILT report (B2BAgg Market Intelligence, code-generated) ---
# Workspace <workspace-id> / report <report-id>
# Page names: regional_demand | supplier_scorecard | top_moving_skus | price_spread
# Embed format per page:
#   https://app.powerbi.com/reportEmbed?reportId=<report-id>&groupId=<workspace-id>&pageName=<page>
