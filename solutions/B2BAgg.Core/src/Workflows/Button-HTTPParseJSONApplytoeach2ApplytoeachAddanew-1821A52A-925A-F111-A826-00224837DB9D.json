{
  "properties": {
    "connectionReferences": {},
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "manual": {
          "metadata": {
            "operationMetadataId": "e3bc2c8d-8f0b-4cbc-a5b9-cbcfeec629bf"
          },
          "type": "Request",
          "kind": "Button",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {},
              "required": []
            }
          }
        }
      },
      "actions": {
        "HTTP": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "787a100b-d325-47de-8a4d-5a2f4a66a7b4"
          },
          "type": "Http",
          "inputs": {
            "method": "GET",
            "uri": "https://func-b2bagg-dev.azurewebsites.net/api/feed/1?code=__FUNCTION_KEY_REMOVED_SEE_P5_REBUILD__"
          }
        },
        "Parse_JSON": {
          "runAfter": {
            "HTTP": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "f54677f8-27a8-4352-aa3d-853aac8c78df"
          },
          "type": "ParseJson",
          "inputs": {
            "content": "@body('HTTP')",
            "schema": {
              "type": "object",
              "properties": {
                "supplier_id": {
                  "type": "string"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "product_name": {
                        "type": "string"
                      },
                      "sku": {
                        "type": "string"
                      },
                      "price_usd": {
                        "type": "number"
                      },
                      "stock_qty": {
                        "type": "integer"
                      },
                      "warehouse": {
                        "type": "string"
                      },
                      "lead_days": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "Apply_to_each": {
          "foreach": "@body('Parse_JSON')?['items']",
          "actions": {
            "HTTP_2": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "389278e0-e054-4114-9687-483f0be6aa30"
              },
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "https://YOUR-DATAVERSE-ORG.crm.dynamics.com/api/data/v9.2/b2b_supplieroffers",
                "headers": {
                  "Content-Type": "application/json",
                  "OData-MaxVersion": "4.0",
                  "OData-Version": "4.0"
                },
                "body": {
                  "b2b_name": "@{items('Apply_to_each')?['sku']}",
                  "b2b_raw_sku": "@{items('Apply_to_each')?['sku']}",
                  "b2b_raw_name": "@{items('Apply_to_each')?['product_name']}",
                  "b2b_price": "@items('Apply_to_each')?['price_usd']",
                  "b2b_stock": "@items('Apply_to_each')?['stock_qty']",
                  "b2b_currency": "USD",
                  "b2b_lead_time_days": "@items('Apply_to_each')?['lead_days']",
                  "b2b_warehouse_city": "@{items('Apply_to_each')?['warehouse']}",
                  "b2b_last_synced": "@{utcNow()}",
                  "b2b_supplier@odata.bind": "/b2b_suppliers(8059989f-445a-f111-a826-00224837db9d)"
                },
                "authentication": {
                  "type": "ActiveDirectoryOAuth",
                  "tenant": "<tenant-id>",
                  "audience": "https://YOUR-DATAVERSE-ORG.crm.dynamics.com",
                  "clientId": "<github-actions-app-id>",
                  "secret": "__CLIENT_SECRET_REMOVED_USE_CONNECTION_REFERENCE_SEE_P5__"
                }
              }
            }
          },
          "runAfter": {
            "Parse_JSON": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "368fac11-9272-4084-8b35-b34fd76745d4"
          },
          "type": "Foreach"
        }
      },
      "outputs": {}
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}