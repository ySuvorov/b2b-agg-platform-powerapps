          "runAfter": {},
          "metadata": {
            "operationMetadataId": "27d5c8bd-808c-426b-b260-b8a970c01d63"
          }
        },
        "Apply_to_each": {
          "type": "Foreach",
          "foreach": "@split(triggerBody()?['text'], ';')",
          "actions": {
            "List_rows": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "b2b_suppliers",
                  "$filter": "b2b_name eq '@{trim(items('Apply_to_each'))}'",
                  "$top": 1
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "connectionName": "shared_commondataserviceforapps"
                }
              },
              "metadata": {
                "operationMetadataId": "877e2d15-814c-44e0-aae6-288f91fa57a4"
              }
            },
            "Condition": {
              "type": "If",
              "expression": {
                "greater": [
                  "@length(outputs('List_rows')?['body/value'])",
                  0
                ]
              },
              "actions": {
                "Add_a_new_row": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "entityName": "b2b_rfqs",
                      "item/b2b_rfq_number": "",
                      "item/b2b_deadline": "@if(empty(triggerBody()?['text_2']), null, triggerBody()?['text_2'])",
                      "item/b2b_notes": "@triggerBody()['text_1']",
                      "item/b2b_sent_at": "@utcNow()",
                      "item/b2b_status": 100000001,
                      "item/b2b_supplier_id@odata.bind": "/b2b_suppliers(@{first(outputs('List_rows')?['body/value'])?['b2b_supplierid']})"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "CreateRecord",
                      "connectionName": "shared_commondataserviceforapps"
                    }
                  },
                  "metadata": {
                    "operationMetadataId": "a07ba760-4e85-4a99-940c-34cea0602d89"
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "List_rows": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "31d65bcc-8e55-48da-8d8a-feb69acc12ec"
              }
            }
          },
          "runAfter": {
            "Initialize_variable": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "dcbd7ba0-66ef-43ce-b02e-95f62c6daff6"
          }
        },
