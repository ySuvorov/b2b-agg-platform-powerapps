            "operationMetadataId": "804c6e42-7f81-4751-9b08-b76e1fb889a9"
          }
        }
      },
      "actions": {
        "Initialize_variable": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "created",
                "type": "integer",
