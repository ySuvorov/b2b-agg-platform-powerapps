              "properties": {
                "created": {
                  "title": "created",
                  "x-ms-dynamically-added": true,
                  "type": "number"
                }
              },
              "additionalProperties": {}
            },
            "statusCode": 200,
            "body": {
              "created": "@{variables('created')}"
            }
          },
          "runAfter": {
            "Apply_to_each": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "e0f1c283-681c-4999-bdea-e961a7593624"
          }
